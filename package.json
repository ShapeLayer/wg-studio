{
  "name": "wiregarden",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src tests index.html vite.config.ts tsconfig*.json package.json"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "qrcode": "^1.5.4"
  }
}
